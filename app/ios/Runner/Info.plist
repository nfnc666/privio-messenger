<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- A wake-up arrives as a background push with no payload. Without this the
	     system delivers it only while the app is in the foreground, which is the
	     one state that did not need a push in the first place.

	     `voip` is deliberately absent: it belongs with PushKit and CallKit,
	     which are not implemented — see docs/notifications.md. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>remote-notification</string>
	</array>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Privio</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<!-- Purpose strings. Apple scans the binary for the frameworks it links and
	     rejects an upload that reaches one without a declared reason:
	     "ITMS-90683 – Missing purpose string in Info.plist". Build 13 was
	     rejected for exactly that, having no camera string while linking
	     AVFoundation's capture APIs through flutter_webrtc.

	     Each string says what the app really does with the hardware and what
	     happens to what it captures. They are shown to the person being asked,
	     so they are written for that person rather than for review. -->
	<!--
	  The app's own URL scheme, `privio://`.

	  This is the half of link handling that needs no domain, no verification
	  file and no Apple configuration — it works on a device the moment the app
	  is installed. Universal Links are the better experience and are configured
	  in `Runner.entitlements`, but they need a registered domain serving a file
	  Apple fetches, and until that exists this is what actually opens a link.
	-->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>CFBundleURLName</key>
			<string>app.privio.privio</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>privio</string>
			</array>
		</dict>
	</array>
	<key>NSCameraUsageDescription</key>
	<string>Privio uses the camera for video calls. The picture goes directly to the person you are calling, end-to-end encrypted; it is never recorded, and Privio's servers cannot see it.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Privio uses the microphone for voice messages and for calls. Both are encrypted on this device before they leave it; Privio's servers cannot listen to them.</string>
	<key>CFBundleName</key>
	<string>privio</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneClassName</key>
					<string>UIWindowScene</string>
					<key>UISceneConfigurationName</key>
					<string>flutter</string>
					<key>UISceneDelegateClassName</key>
					<string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
					<key>UISceneStoryboardFile</key>
					<string>Main</string>
				</dict>
			</array>
		</dict>
	</dict>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
</dict>
</plist>
