<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<!--
  What iOS shows between tapping the icon and Flutter's first frame.

  Black, and nothing else. Two changes from what was here:

  * The background was **white** — the Flutter template's — in front of an app
    that is true black throughout. That was a white flash on every cold launch.
  * The green mark is gone. The mark now follows the account's accent, and a
    launch storyboard cannot: iOS renders it before any of our code runs, so
    there is no preference to read and nothing to read it with. Drawing the
    green one here for somebody whose app is pink is the colour flash this work
    exists to remove. Black hands over to a Flutter view on the same black,
    which draws the mark in the right colour straight away.

  The `LaunchImage` image set is left in the asset catalogue rather than
  deleted: it is still generated from the master by tools/generate_brand_assets.py
  and is what a future launch screen would use if Apple ever makes one dynamic.
  The home-screen icon is a different asset and is unchanged — see docs/app-icon.md.
-->
<document type="com.apple.InterfaceBuilder3.CocoaTouch.Storyboard.XIB" version="3.0" toolsVersion="12121" systemVersion="16G29" targetRuntime="iOS.CocoaTouch" propertyAccessControl="none" useAutolayout="YES" launchScreen="YES" colorMatched="YES" initialViewController="01J-lp-oVM">
    <dependencies>
        <deployment identifier="iOS"/>
        <plugIn identifier="com.apple.InterfaceBuilder.IBCocoaTouchPlugin" version="12089"/>
    </dependencies>
    <scenes>
        <!--View Controller-->
        <scene sceneID="EHf-IW-A2E">
            <objects>
                <viewController id="01J-lp-oVM" sceneMemberID="viewController">
                    <layoutGuides>
                        <viewControllerLayoutGuide type="top" id="Ydg-fD-yQy"/>
                        <viewControllerLayoutGuide type="bottom" id="xbc-2k-c8Z"/>
                    </layoutGuides>
                    <view key="view" contentMode="scaleToFill" id="Ze5-6b-2t3">
                        <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                        <color key="backgroundColor" red="0" green="0" blue="0" alpha="1" colorSpace="custom" customColorSpace="sRGB"/>
                    </view>
                </viewController>
                <placeholder placeholderIdentifier="IBFirstResponder" id="iYj-Kq-Ea1" userLabel="First Responder" sceneMemberID="firstResponder"/>
            </objects>
            <point key="canvasLocation" x="53" y="375"/>
        </scene>
    </scenes>
</document>
