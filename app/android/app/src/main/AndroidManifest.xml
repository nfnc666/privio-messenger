<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Voice messages. Asked for at the moment the microphone is first held,
         not at launch: a permission prompt with no context is a permission
         prompt people deny. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Android 13 and later. Asked for when someone turns notifications on,
         not at launch. A refusal costs the notification and not the message:
         the push still wakes the process and the envelopes still arrive. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:label="@string/app_name"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <!-- The launcher entry lives on the aliases below, not here: an
             activity that is itself the launcher cannot be disabled without
             taking the running app with it. MainActivity stays the one real
             activity and the aliases decide what the launcher shows. -->
        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />

            <!-- Privio's own scheme.

                 This needs no domain, no verification file and nothing from
                 Google: it works the moment the app is installed. It is what
                 actually opens a link today. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="privio"/>
            </intent-filter>

            <!-- Android App Links, for the https form.

                 `autoVerify` makes Android fetch
                 `https://<host>/.well-known/assetlinks.json` at install time.
                 That file is served from this project's own server and answers
                 404 until the package name and signing fingerprints are
                 configured — which is a working state: verification simply
                 fails, the link opens in a browser, and the browser shows the
                 invite page, which has a button.

                 Only `/open/` is claimed. That is the whole design: the shared
                 link shows the page, and the button on it hands the link over.
                 Claiming the share paths here would mean the app swallowing
                 every link before anybody saw a page.

                 The host is a placeholder until the domain is registered. It
                 has to match `ChannelService.channelLinkHost` and the server's
                 `PUBLIC_WEB_URL`; see docs/invite-links.md. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="https" android:host="privio.channel" android:pathPrefix="/open/"/>
            </intent-filter>
        </activity>

        <!-- Privio's own entry. Enabled unless the disguise is on. -->
        <activity-alias
            android:name=".DefaultLauncher"
            android:targetActivity=".MainActivity"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity-alias>

        <!-- The disguise. Same activity behind it, so the app that opens is
             the same app; only what the launcher draws and calls it differs. -->
        <activity-alias
            android:name=".CalculatorLauncher"
            android:targetActivity=".MainActivity"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_calculator"
            android:label="@string/calculator_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity-alias>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- Opening a link somebody put in a channel post. Android 11 hides
             other packages unless they are declared here, and a browser the app
             cannot see is a link that silently does nothing. Only http and
             https: a post does not get to hand the phone a tel: or an app
             scheme. -->
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="https"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="http"/>
        </intent>
    </queries>
</manifest>
