<?xml version="1.0" encoding="utf-8"?>
<!--
  The adaptive launcher icon, for Android 8 and up.

  The launcher masks this to whatever shape the device uses — circle, squircle,
  teardrop — and only the middle 72dp of the 108dp canvas is ever visible. The
  foreground therefore carries the mark scaled into that 72dp window, so inside
  any mask the glyph sits at exactly the proportion it has in the delivered
  square. The background is a flat colour rather than a bitmap: it is solid
  black at every density and a PNG of it would only be five files to keep in
  step.

  The legacy PNGs in mipmap-<density>/ic_launcher.png stay for Android 7 and
  below, which ignores this file.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
    <monochrome android:drawable="@mipmap/ic_launcher_foreground" />
</adaptive-icon>
