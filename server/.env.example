# Privio server configuration. Copy to .env and adjust.
NODE_ENV=development
HOST=0.0.0.0
PORT=8080

# PostgreSQL. The server runs its own migrations on boot.
DATABASE_URL=postgres://privio@localhost:5432/privio

# Optional. Without it the server runs single-node with an in-process event bus;
# set it as soon as more than one API instance is behind the load balancer.
# REDIS_URL=redis://localhost:6379

# Where client-encrypted attachments and backups are written.
MEDIA_DIR=./.data/media
MEDIA_TTL_DAYS=30
ENVELOPE_TTL_DAYS=30
SESSION_TTL_DAYS=365

# How often an open WebSocket re-reads its session, in milliseconds.
#
# A logout, a device revocation or a password change is broadcast over the bus
# and closes the socket at once. This is the backstop for what a broadcast
# cannot cover: a session that merely expired, and a revocation published while
# this process was disconnected from Redis. It is therefore the outer bound on
# how long an ended session keeps a connection it already had. Lower is
# prompter and costs one query per open connection per interval.
WS_REVALIDATE_MS=60000

MAX_ENVELOPE_BYTES=65536
MAX_MEDIA_BYTES=104857600
MAX_BACKUP_BYTES=536870912

# Browser origins allowed to call the API. Native apps do not need this; it is
# for local development against a web build, and for a future web client.
# CORS_ORIGINS=http://localhost:8099

LOG_LEVEL=info

# --- Licensing ---------------------------------------------------------------
# Privio Libre and the direct APK are activated with a license key. Self-hosted
# deployments leave this off: a licence for your own infrastructure means
# nothing, and the app is told not to ask for a key.
LICENSE_REQUIRED=false

# Key for the HMAC that license keys are stored under. Required when
# LICENSE_REQUIRED=true. Generate with `openssl rand -base64 32`.
# Rotating it orphans every license ever issued — treat it as permanent.
# LICENSE_HASH_SECRET=

# Bearer token the website presents to /v1/internal/licenses. Shared with the
# website and nothing else.
# LICENSE_ISSUER_TOKEN=

# Hosts that may be registered as UnifiedPush endpoints, comma separated.
# Empty means any publicly routable https host, which is the point: the
# distributor is the user's choice and is often their own. Narrow it only if
# this deployment would rather not make outbound requests to wherever.
UNIFIEDPUSH_ALLOWED_HOSTS=

# Where calls look for each other. Comma-separated STUN and TURN URLs, handed
# to clients over GET /v1/calls/ice so a build needs no flags of its own.
# Empty is a real answer: the two devices then try only the addresses they can
# see for themselves, which works on one network and behind simple NATs and
# fails behind strict ones. Privio runs no relay for you to point at.
ICE_SERVERS=

# Shared secret for TURN credentials, matching coturn's static-auth-secret.
# With it, the API mints a time-limited username and password per request; a
# fixed pair shipped inside a client is a public relay within a day. The
# username is the expiry and nothing else — no account id, so the relay
# operator cannot tie relayed calls to accounts.
TURN_SECRET=
TURN_TTL_SECONDS=43200

# Seals TOTP secrets at rest. Base64 of 32 random bytes:
#   openssl rand -base64 32
# A TOTP secret never expires, so in the clear a leaked database defeats the
# second factor for every account without anyone touching the server. Keep this
# key out of the database and out of any backup that contains it — it separates
# the two, and does nothing if they are kept together.
#
# Without it the server runs and refuses to enrol anyone in two-factor, rather
# than quietly storing the next secret unsealed. Accounts already enrolled keep
# working.
TOTP_SECRET_KEY=

# --- Push ---------------------------------------------------------------------
# All four APNs values together or none; the same for the three FCM ones. Half
# configured is refused at start-up, because it looks like it works and does not.
#
# APNS_KEY_P8 is the contents of the .p8 file, not a path — a key on disk is a
# key in every image and every backup. Newlines may be written as \n.
# APNS_ENVIRONMENT is production for anything signed for distribution,
# TestFlight included; sandbox is only for a build installed from Xcode with a
# development profile.
# APNS_KEY_P8=
# APNS_KEY_ID=
# APNS_TEAM_ID=
# APNS_TOPIC=app.privio.privio
APNS_ENVIRONMENT=production

# The three fields taken out of the service-account JSON Google hands you,
# rather than the whole file, so the server holds exactly what it needs.
# FCM_PROJECT_ID=
# FCM_CLIENT_EMAIL=
# FCM_PRIVATE_KEY=

# --- In production ------------------------------------------------------------
# With NODE_ENV=production the server refuses to start unless DATABASE_URL is
# set explicitly: the development default above points at localhost, and
# inheriting it on a server means migrating a database nobody uses while every
# request fails — a failure that looks like a successful deploy. A localhost
# address stated on purpose is still fine.
#
# It warns and runs when MEDIA_DIR is left at the default (attachments in the
# container's filesystem, discarded on the next deploy), when TOTP_SECRET_KEY is
# unset (no two-factor enrolment), and when REDIS_URL is unset (single node).
#
# docs/deployment.md is the whole path: a Render Blueprint, a plain Docker host,
# and what has actually been verified.
