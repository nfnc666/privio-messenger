{
  "name": "@privio/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Privio backend: zero-plaintext relay for E2EE messaging",
  "license": "AGPL-3.0-only",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "migrate": "tsx src/db/migrate.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "NODE_ENV=test DATABASE_URL=${TEST_DATABASE_URL:-postgres://postgres@localhost:5432/privio_test} LICENSE_HASH_SECRET=${LICENSE_HASH_SECRET:-test-license-hash-secret-0123456789} LICENSE_ISSUER_TOKEN=${LICENSE_ISSUER_TOKEN:-test-license-issuer-token-0123456789} tsx --test --test-concurrency=1 test/*.test.ts"
  },
  "dependencies": {
    "@fastify/cors": "^10.1.0",
    "@fastify/rate-limit": "^10.2.2",
    "@fastify/websocket": "^11.0.2",
    "@node-rs/argon2": "^2.0.2",
    "fastify": "^5.2.1",
    "fastify-plugin": "^5.1.0",
    "ioredis": "^5.4.2",
    "otplib": "^12.0.1",
    "pg": "^8.13.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
